{
  "name": "miles-and-meals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "vitest run",
    "db:reset": "tsx scripts/reset-db.ts",
    "predev": "npm run cleanup:legacy && node ./scripts/copy-maplibre-worker.mjs",
    "prebuild": "npm run cleanup:legacy && node ./scripts/copy-maplibre-worker.mjs && npm run pwa:check && npm run navigation:check && npm run phase8:check && npm run v53:check && npm run v54:check && npm run v55:check && npm run v56:check",
    "cleanup:legacy": "node ./scripts/cleanup-legacy-files.mjs",
    "pwa:check": "node scripts/validate-pwa.mjs",
    "navigation:check": "npm run cleanup:legacy && node scripts/validate-navigation.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "phase8:check": "npm run cleanup:legacy && node scripts/validate-phase8.mjs",
    "v53:check": "node scripts/validate-v53.mjs",
    "v54:check": "node scripts/validate-v54.mjs",
    "v55:check": "node scripts/validate-v55.mjs",
    "v56:check": "node scripts/validate-v56.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "6.4.0",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "tesseract.js": "7.0.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/web-push": "3.6.4",
    "@playwright/test": "1.62.1"
  }
}
