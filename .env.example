DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use a REAL inbox so Forgot Password can deliver to the Admin.
ADMIN_NAME=Travel Admin
ADMIN_EMAIL=your-real-email@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Local development: leave blank and the reset link is printed in the terminal.
# Production/Vercel: configure both.
RESEND_API_KEY=
EMAIL_FROM="Miles & Meals <noreply@your-verified-domain.com>"

# Safety flag for npm run db:reset.
# Do not keep this enabled permanently.
RESET_DATABASE=NO
