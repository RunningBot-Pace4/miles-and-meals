DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

BETTER_AUTH_SECRET="replace-with-a-new-random-secret-at-least-32-characters"

# Local development
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_NAME="Travel Admin"
ADMIN_EMAIL="your-real-email@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Keep NO normally. Only enable temporarily when intentionally wiping ALL Neon objects.
RESET_DATABASE="NO"

# Safer reset: clears trip/app data but preserves Better Auth users/login accounts.
# Make a Neon backup/branch first, then temporarily set YES for db:reset:keep-login.
RESET_APP_DATA="NO"

# Receipt OCR + photo storage
# No receipt API/storage key is required.
# OCR runs in the browser; compressed receipt photos use the existing Neon DB.

# Phase 8 Web Push (generate once with: npm run push:keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional Trip Inbox flight schedule lookup. Keep this server-side only.
# The provider plan must support the dates/schedules your deployment needs.
AVIATIONSTACK_API_KEY=
