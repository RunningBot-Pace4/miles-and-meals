DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

BETTER_AUTH_SECRET="replace-with-a-new-random-secret-at-least-32-characters"

# Local development
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_NAME="Travel Admin"
ADMIN_EMAIL="your-real-email@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Keep NO normally. Only enable temporarily when intentionally wiping Neon.
RESET_DATABASE="NO"

# Receipt photo storage
# Vercel automatically provides this when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=""


# Receipt OCR
# No API key is required. Tesseract.js runs OCR in the browser.
# Receipt photo persistence remains optional via Vercel Blob.
