DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

BETTER_AUTH_SECRET="replace-with-a-new-random-secret-at-least-32-characters"

# Local development
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_NAME="Travel Admin"
ADMIN_EMAIL="your-real-email@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Keep NO normally. Only enable temporarily when intentionally wiping Neon.
RESET_DATABASE="NO"

# Receipt photo AI
# Create this in the OpenAI API platform. Keep it server-side only.
OPENAI_API_KEY=""
OPENAI_RECEIPT_MODEL="gpt-5-mini"

# Receipt photo storage
# Vercel automatically provides this when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=""

