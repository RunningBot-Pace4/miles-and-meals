# Keep NO normally. Only enable temporarily when intentionally wiping Neon.
RESET_DATABASE="NO"

# Receipt OCR + photo storage
# No receipt API/storage key is required.
# OCR runs in the browser; compressed receipt photos use the existing Neon DB.
